# Django
SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=false
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://app.example.com
SECURE_SSL_REDIRECT=true
SERVE_MEDIA=false
TIME_ZONE=Asia/Manila
LOG_LEVEL=INFO

# MySQL
DB_NAME=hazard_hero
DB_USER=hazard_hero
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=mysql.example.internal
DB_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
# DB_SSL_CA=/run/secrets/mysql-ca.pem

# Runtime
PORT=8000
HOST_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
RUN_MIGRATIONS=true
DATABASE_STARTUP_ATTEMPTS=12
DATABASE_STARTUP_DELAY_SECONDS=5

# API
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7
PAGE_SIZE=20
MAX_UPLOAD_SIZE=10485760
FRONTEND_RESET_URL=https://app.example.com/reset-password

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
